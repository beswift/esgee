# build output
bin/
obj/
publish/
Releases/

# local promote/probe scratch — real-settings.json inside carries the live
# PeerToken, so this directory must never be committable
build/

# user/IDE state
*.user
*.suo
.vs/
.idea/

# local agent state
.claude/

# macOS app — the project is generated from mac/project.yml (xcodegen)
# The Xcode project is CHECKED IN so a fresh clone opens in Xcode with no
# tooling. It is still generated: edit mac/project.yml, run xcodegen, commit
# both. Only user-state inside it stays ignored.
mac/*.xcodeproj/xcuserdata
mac/*.xcodeproj/project.xcworkspace/xcuserdata
mac/DerivedData/
mac/.build/
