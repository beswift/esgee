<UserControl x:Class="Esgee.Ui.ShotCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="196" Margin="0,0,0,10"
             RenderTransformOrigin="0.5,0.5">

    <UserControl.RenderTransform>
        <TransformGroup>
            <ScaleTransform x:Name="Scale" ScaleX="1" ScaleY="1" />
            <TranslateTransform x:Name="Slide" X="0" Y="0" />
        </TransformGroup>
    </UserControl.RenderTransform>

    <Border Background="{StaticResource Surface}"
            BorderBrush="{StaticResource Hairline}" BorderThickness="1"
            CornerRadius="12" Padding="6"
            Effect="{StaticResource CardLift}">
        <Grid>
            <!-- The thumbnail. Clipped to a rounded rect so it matches the card. -->
            <Border CornerRadius="7" ClipToBounds="True" MinHeight="52">
                <Image x:Name="Thumb" Stretch="Uniform" MaxHeight="128"
                       RenderOptions.BitmapScalingMode="HighQuality" />
            </Border>

            <!-- Recording badge: play glyph + duration, only for videos. -->
            <Border x:Name="VideoBadge" Visibility="Collapsed"
                    HorizontalAlignment="Left" VerticalAlignment="Top"
                    Margin="6" CornerRadius="5" Padding="6,2,7,3"
                    Background="{StaticResource Scrim}">
                <TextBlock x:Name="VideoBadgeText" FontSize="11"
                           Foreground="{StaticResource Ink}" />
            </Border>

            <!-- Hover chrome. Hidden until the pointer arrives so the resting
                 state stays quiet against whatever is behind it. -->
            <Grid x:Name="Chrome" Opacity="0" VerticalAlignment="Bottom">
                <Border CornerRadius="0,0,7,7" Height="34" Background="{StaticResource Scrim}" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <Button x:Name="CopyBtn"   Style="{StaticResource IconButton}"
                            Content="&#xE8C8;" FontFamily="Segoe Fluent Icons"
                            ToolTip="Copy to clipboard" />
                    <Button x:Name="FolderBtn" Style="{StaticResource IconButton}"
                            Content="&#xE838;" FontFamily="Segoe Fluent Icons"
                            ToolTip="Show in folder" />
                    <!-- The fifth icon (docs/SHARES.md "the Slack bar"):
                         collapsed until a team share is configured. -->
                    <Button x:Name="ShareBtn"  Style="{StaticResource IconButton}"
                            Content="&#xE72D;" FontFamily="Segoe Fluent Icons"
                            ToolTip="Push to team share" Visibility="Collapsed" />
                    <Button x:Name="PinBtn"    Style="{StaticResource IconButton}"
                            Content="&#xE718;" FontFamily="Segoe Fluent Icons"
                            ToolTip="Keep on shelf" />
                    <Button x:Name="CloseBtn"  Style="{StaticResource IconButton}"
                            Content="&#xE711;" FontFamily="Segoe Fluent Icons"
                            ToolTip="Dismiss" />
                </StackPanel>
            </Grid>

            <!-- Time-to-dismiss. A thin bar reads at a glance without demanding
                 attention the way a countdown number would. -->
            <Border x:Name="TimerTrack" Height="2" VerticalAlignment="Bottom"
                    HorizontalAlignment="Left" CornerRadius="1"
                    Background="{StaticResource Accent}" Width="184" />

            <!-- Share outcome: a quiet badge, top-right so it never fights the
                 recording badge. Never a dialog, never a toast — anything
                 modal here loses to Slack on feel (docs/SHARES.md). -->
            <Border x:Name="ShareBadge" Visibility="Collapsed"
                    HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="6" CornerRadius="5" Padding="6,2,7,3"
                    Background="{StaticResource Scrim}">
                <TextBlock x:Name="ShareBadgeText" FontSize="11"
                           Foreground="{StaticResource Ink}" />
            </Border>

            <!-- Confirmation flash on copy. -->
            <Border x:Name="Flash" CornerRadius="7" Background="White" Opacity="0"
                    IsHitTestVisible="False" />
        </Grid>
    </Border>
</UserControl>
