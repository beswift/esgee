<Window x:Class="Esgee.Ui.ArchiveWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="esgee archive"
        Width="1060" Height="700" MinWidth="560" MinHeight="360"
        Background="#141418" WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Search bar. The placeholder doubles as the how-to. -->
        <Grid Grid.Row="0" Margin="16,14,16,10">
            <Border Background="{StaticResource Surface}"
                    BorderBrush="{StaticResource Hairline}" BorderThickness="1"
                    CornerRadius="9">
                <Grid>
                    <TextBox x:Name="SearchBox" Background="Transparent" BorderThickness="0"
                             Foreground="{StaticResource Ink}" CaretBrush="{StaticResource Ink}"
                             FontSize="14" Padding="12,9"
                             TextChanged="OnSearchChanged" />
                    <TextBlock x:Name="Placeholder" Margin="14,0,0,0" VerticalAlignment="Center"
                               Foreground="{StaticResource InkMuted}" FontSize="14"
                               IsHitTestVisible="False"
                               Text="Search by any text that was on screen…" />
                </Grid>
            </Border>
        </Grid>

        <!-- Results grid. Click previews; drag any tile out as a file. -->
        <ListBox x:Name="Results" Grid.Row="1" Margin="10,0,10,10"
                 Background="Transparent" BorderThickness="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 VirtualizingPanel.ScrollUnit="Pixel">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Margin" Value="6" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border x:Name="Card" Background="{StaticResource Surface}"
                                        BorderBrush="{StaticResource Hairline}" BorderThickness="1"
                                        CornerRadius="10" Padding="6">
                                    <ContentPresenter />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Card" Property="Background"
                                                Value="{StaticResource SurfaceHover}" />
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Card" Property="BorderBrush"
                                                Value="{StaticResource Accent}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
        </ListBox>

        <!-- Empty state. -->
        <TextBlock x:Name="Empty" Grid.Row="1" HorizontalAlignment="Center"
                   VerticalAlignment="Center" FontSize="14"
                   Foreground="{StaticResource InkMuted}" Visibility="Collapsed" />

        <!-- Lightbox preview: click a tile to open, Esc / click-away to close,
             arrow keys to move through the current results. -->
        <Grid x:Name="PreviewLayer" Grid.RowSpan="2" Visibility="Collapsed">
            <Border x:Name="PreviewScrim" Background="#E00B0B0E"
                    MouseLeftButtonDown="OnScrimClick" />

            <Border MaxWidth="960" MaxHeight="620" Margin="40"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{StaticResource Surface}"
                    BorderBrush="{StaticResource Hairline}" BorderThickness="1"
                    CornerRadius="14" Padding="10"
                    Effect="{StaticResource CardLift}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Stills use the Image; videos swap in a muted looping player. -->
                    <Border Grid.Row="0" CornerRadius="8" ClipToBounds="True"
                            MinWidth="320" MinHeight="200">
                        <Grid>
                            <Image x:Name="PreviewImage" Stretch="Uniform"
                                   RenderOptions.BitmapScalingMode="HighQuality" />
                            <MediaElement x:Name="PreviewVideo" Stretch="Uniform"
                                          LoadedBehavior="Manual" UnloadedBehavior="Stop"
                                          Volume="0" Visibility="Collapsed"
                                          MediaEnded="OnPreviewVideoEnded" />
                        </Grid>
                    </Border>

                    <DockPanel Grid.Row="1" Margin="4,10,4,2" LastChildFill="False">
                        <TextBlock x:Name="PreviewCaption" DockPanel.Dock="Left"
                                   VerticalAlignment="Center" FontSize="12"
                                   Foreground="{StaticResource InkMuted}" />
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <TextBlock Text="‹ › navigate   Esc close" Margin="0,0,14,0"
                                       VerticalAlignment="Center" FontSize="11"
                                       Foreground="{StaticResource InkMuted}" Opacity="0.7" />
                            <Button x:Name="PreviewCopyBtn" Style="{StaticResource IconButton}"
                                    Content="&#xE8C8;" FontFamily="Segoe Fluent Icons"
                                    ToolTip="Copy to clipboard" Click="OnPreviewCopy" />
                            <Button x:Name="PreviewFolderBtn" Style="{StaticResource IconButton}"
                                    Content="&#xE838;" FontFamily="Segoe Fluent Icons"
                                    ToolTip="Show in folder" Click="OnPreviewReveal" />
                            <Button Style="{StaticResource IconButton}"
                                    Content="&#xE711;" FontFamily="Segoe Fluent Icons"
                                    ToolTip="Close" Click="OnPreviewClose" />
                        </StackPanel>
                    </DockPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
