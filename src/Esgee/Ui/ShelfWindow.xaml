<Window x:Class="Esgee.Ui.ShelfWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="esgee shelf"
        Width="228" Height="680"
        WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="{x:Null}"
        ShowInTaskbar="False" ShowActivated="False" Topmost="True"
        Focusable="False">

    <!-- Background stays null rather than Transparent: a null brush is not
         hit-testable, so clicks in the gaps between cards fall through to
         whatever app is underneath. -->
    <Grid Background="{x:Null}">
        <StackPanel x:Name="Cards"
                    VerticalAlignment="Bottom" HorizontalAlignment="Right"
                    Margin="16,0,0,0" />
    </Grid>
</Window>
