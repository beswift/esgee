<Window x:Class="Esgee.Capture.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="esgee capture"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        Topmost="True" Background="Black" Cursor="Cross"
        KeyDown="OnKey">

    <Grid>
        <!-- The frozen desktop. Everything else draws over this still. -->
        <Image x:Name="Frame" Stretch="Fill" />

        <!-- Dimming with a live hole for the selection / hovered window. -->
        <Path x:Name="Dim" Fill="#66000000" IsHitTestVisible="False" />

        <Canvas IsHitTestVisible="False">
            <!-- Crosshair guides before a drag starts. -->
            <Line x:Name="GuideV" Stroke="#805B8CFF" StrokeThickness="1" />
            <Line x:Name="GuideH" Stroke="#805B8CFF" StrokeThickness="1" />

            <!-- Selection / window-snap outline. -->
            <Rectangle x:Name="Outline" Stroke="{StaticResource Accent}"
                       StrokeThickness="1.5" Visibility="Collapsed" />

            <!-- Pixel dimensions readout. -->
            <Border x:Name="Badge" Background="{StaticResource Surface}"
                    BorderBrush="{StaticResource Hairline}" BorderThickness="1"
                    CornerRadius="6" Padding="8,3" Visibility="Collapsed">
                <TextBlock x:Name="BadgeText" Foreground="{StaticResource Ink}"
                           FontFamily="Consolas" FontSize="12" />
            </Border>
        </Canvas>

        <!-- Key hints. Fades once the user starts doing anything. -->
        <Border x:Name="Hints" VerticalAlignment="Bottom" HorizontalAlignment="Center"
                Margin="0,0,0,36" Background="{StaticResource Surface}"
                BorderBrush="{StaticResource Hairline}" BorderThickness="1"
                CornerRadius="8" Padding="14,7" IsHitTestVisible="False">
            <TextBlock Foreground="{StaticResource InkMuted}" FontSize="12"
                       Text="drag — region   ·   click — window   ·   Enter — full screen   ·   1–9 — delay   ·   Esc — cancel" />
        </Border>
    </Grid>
</Window>
